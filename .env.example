# Copy to .env.local. Everything here is required for signing in with X.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# X rejects `localhost` in callback URLs but accepts 127.0.0.1, and cookies are
# per-host — so browse the dev server at 127.0.0.1:3000 too, or the session
# will not follow you back from X.
BETTER_AUTH_URL=http://127.0.0.1:3000

# console.x.com -> your app -> User authentication settings.
# Type of App must be "Web App" (a confidential client): it is the only kind
# that issues a client secret. Callback URI, matched exactly:
#   http://127.0.0.1:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Production only. Unset, the app runs on the local PGlite file and writes
# --- uploads to public/uploads; both are refused in a deployment.

# Postgres. Migrations run at deploy time: `pnpm db:migrate`, never on boot.
DATABASE_URL=

# The header carrying the caller's address. Must be one the platform sets and
# a client cannot forge through it — cf-connecting-ip behind Cloudflare,
# x-forwarded-for behind most proxies. Unset, every caller shares one bucket.
TRUSTED_IP_HEADER=

# Boot screen storage. S3-compatible; R2 works with region "auto".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The origin boot screen urls are written with, and the only one the board
# will accept — a CDN in front of the bucket, or the bucket's public host.
PUBLIC_UPLOAD_BASE=

# The Datafast dashboard, shared publicly. Optional: unset, the Analytics page
# shows the site's own figures and no link out. The tracking script itself is
# not configured here — the site id ships in the page anyway, so it lives in
# src/lib/links.ts, and it only loads in a production build.
NEXT_PUBLIC_ANALYTICS_URL=
