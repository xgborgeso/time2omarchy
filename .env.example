# The one template. Copy it and fill it in:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and is the only file you edit; this one stays
# empty and tracked so the list of variables stays reviewable. Keep your filled
# copy in a password manager — everything with a value in it is a credential.

# --- Required for local development ------------------------------------------

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# X rejects `localhost` in callback URLs but accepts 127.0.0.1, and cookies are
# per-host — so browse the dev server at 127.0.0.1:3000 too, or the session
# will not follow you back from X.
BETTER_AUTH_URL=http://127.0.0.1:3000

# console.x.com -> your app -> User authentication settings.
# Type of App must be "Web App" (a confidential client): it is the only kind
# that issues a client secret. Callback URI, matched exactly:
#   http://127.0.0.1:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# uploadthing.com -> your app -> API Keys. Boot screens go from the browser
# straight to UploadThing, so this is needed to rank at all, in development
# too. The seeded board renders without it; a new upload will not work.
UPLOADTHING_TOKEN=

# The origin uploaded boot screens are served from, and the only one the board
# will accept. UploadThing serves them at https://<app-id>.ufs.sh
PUBLIC_UPLOAD_BASE=

# --- Production only ----------------------------------------------------------
# Unset, the app runs on the local PGlite file, which is refused in a
# deployment. `pnpm preflight` checks all of this before you ship.

# Postgres. Migrations run at deploy time: `pnpm db:migrate`, never on boot.
DATABASE_URL=

# The header carrying the caller's address. Must be one the platform sets and
# a client cannot forge through it — cf-connecting-ip behind Cloudflare,
# x-forwarded-for behind most proxies. Unset, every caller shares one bucket.
TRUSTED_IP_HEADER=

# --- Optional -----------------------------------------------------------------

# The Datafast dashboard, shared publicly. Unset, the Analytics page shows the
# site's own figures and no link out. The tracking script itself is not
# configured here — the site id ships in the page anyway, so it lives in
# src/lib/links.ts, and it only loads in a production build.
NEXT_PUBLIC_ANALYTICS_URL=
