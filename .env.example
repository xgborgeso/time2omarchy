# Copy to .env.local. Everything here is required for signing in with X.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the app runs. Must match the callback URI registered with X.
BETTER_AUTH_URL=http://localhost:3000

# developer.x.com → your app → User authentication settings.
# Type of App must be "Web App, Automated App or Bot" — it is the only option
# that issues a client secret. Callback URI:
#   http://localhost:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
