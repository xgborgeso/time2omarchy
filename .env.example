# Copy this to .env and fill it in. That is everything needed to run locally:
#
#   cp .env.example .env
#
# .env is git-ignored. Production needs more than this, and those variables are
# deliberately not listed here — `pnpm preflight` names each one it wants.

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# 127.0.0.1, never localhost: X refuses to register a `localhost` callback, and
# cookies are per-host, so a session started there would not follow you back.
# Browse the dev server at 127.0.0.1:3000 for the same reason.
BETTER_AUTH_URL=http://127.0.0.1:3000

# console.x.com -> your app -> User authentication settings.
# Type of App must be "Web App": it is the only kind that issues a secret.
# Callback URI, matched exactly:
#   http://127.0.0.1:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# uploadthing.com -> your app -> API Keys. Boot screens go from the browser
# straight to UploadThing, so ranking needs this in development too.
UPLOADTHING_TOKEN=

# The origin uploads are served from, and the only one the board will accept.
# The app id is the one inside the token above.
PUBLIC_UPLOAD_BASE=https://<app-id>.ufs.sh

# --- Optional ------------------------------------------------------------

# Better Stack, for server errors. Unset, they go to the console only —
# which is what development wants. Both values come from one source:
# betterstack.com -> Telemetry -> Sources -> your source.
#
# The credits-exhausted message is the one worth an email alert: when the X
# developer account runs dry nobody can rank, and nothing else will tell you.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=
