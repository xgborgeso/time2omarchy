# Copy this to .env and fill it in:
#
#   cp .env.example .env
#
# .env is git-ignored, along with every other env-shaped name. This template is
# the only one in the repository, and it holds exactly what local development
# needs — production variables are deliberately absent; `pnpm preflight` names
# those when you deploy.
#
# You can run the whole site with none of this filled in. `pnpm db:fresh`
# seeds a hundred and twenty entries and the board, stats and rules pages all
# work. Only *ranking* needs credentials, because it goes through X and
# UploadThing, and both are third parties in development too.

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# 127.0.0.1, never localhost: X refuses to register a `localhost` callback, and
# cookies are per-host, so a session started there would not follow you back.
# Browse the dev server at 127.0.0.1:3000 for the same reason.
BETTER_AUTH_URL=http://127.0.0.1:3000

# console.x.com -> your app -> User authentication settings.
# Type of App must be "Web App": it is the only kind that issues a secret.
# Callback URI, matched exactly:
#   http://127.0.0.1:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# uploadthing.com -> your app -> API Keys.
UPLOADTHING_TOKEN=

# The origin uploads are served from, and the only one the board will accept.
# The app id is the one inside the token above.
PUBLIC_UPLOAD_BASE=https://<app-id>.ufs.sh
