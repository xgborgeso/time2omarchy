# Copy to .env.local. Everything here is required for signing in with X.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# X rejects `localhost` in callback URLs but accepts 127.0.0.1, and cookies are
# per-host — so browse the dev server at 127.0.0.1:3000 too, or the session
# will not follow you back from X.
BETTER_AUTH_URL=http://127.0.0.1:3000

# console.x.com -> your app -> User authentication settings.
# Type of App must be "Web App" (a confidential client): it is the only kind
# that issues a client secret. Callback URI, matched exactly:
#   http://127.0.0.1:3000/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
