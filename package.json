{
  "name": "time2omarchy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastest verified Omarchy installs leaderboard",
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "build": "next build",
    "db:fresh": "pnpm db:reset && pnpm db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/db-guard.ts 'resetting the database' && rm -rf data/dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "preflight": "tsx scripts/preflight.ts",
    "reports": "tsx scripts/reports.ts",
    "start": "next start",
    "takedown": "tsx scripts/takedown.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@tanstack/react-query": "^5.102.5",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.11.6",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.0.0"
}
