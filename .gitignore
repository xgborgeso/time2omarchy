node_modules
.next
next-env.d.ts
*.tsbuildinfo

# PGlite's local database and the boot screens uploaded into it.
data
public/uploads/*
!public/uploads/.gitkeep

# Nothing sets these today, but they must be ignored before the first one
# exists, not after.
# Everything env-shaped is ignored, and the template is the one exception.
# Listing files individually left gaps: .env.production, .env.backup and
# .env.save were all committable, and a leaked one is not un-leaked by a later
# commit removing it.
.env*
!.env.example

.DS_Store

# Third-party agent skills, installed per-machine with `npx skills add`.
# Tools, not source: 3.6MB of vendored data and compiled bytecode does not
# belong in a repo this deliberately lean.
.agents/
.claude/skills/
skills-lock.json
.neon
